# Database Configuration (Defaults to SQLite for instant local dev without Docker)
DATABASE_URL=sqlite:///./skillgap.db
# For PostgreSQL:
# DATABASE_URL=postgresql://skillgap_user:skillgap_password@localhost:5432/skillgap_db

# Security & Session Authentication
SECRET_KEY=skillgap_secret_key_antigravity_2026_supersecure
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional Neural Polish (System remains fully functional via deterministic engine if omitted)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

